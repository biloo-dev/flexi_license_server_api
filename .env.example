# Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=flexi-license-server
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flexi-license-server.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Optional: Firestore Emulator for local testing
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Cryptography & Ed25519 License Key Configuration
LICENSE_KEY_ID=2026-01
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ED25519_PRIVATE_KEY_PEM_HERE\n-----END PRIVATE KEY-----"
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ED25519_PUBLIC_KEY_PEM_HERE\n-----END PUBLIC KEY-----"

# License Server Settings
LICENSE_OFFLINE_GRACE_PERIOD_HOURS=48
LICENSE_DEFAULT_VALIDITY_DAYS=365

# Security & JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=7d
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Default Initial Admin Credentials
ADMIN_EMAIL=admin@flexi.dz
ADMIN_PASSWORD=AdminFlexi2026!

# CORS
CORS_ORIGINS=*
